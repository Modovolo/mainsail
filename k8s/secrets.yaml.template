---
# Fleet Manager Secrets
# IMPORTANT: Copy this file to secrets.yaml and update the values!
# Do NOT commit secrets.yaml to version control.
#
# To create secrets.yaml:
#   cp secrets.yaml.template secrets.yaml
#   # Edit secrets.yaml with your actual values
#   kubectl apply -f secrets.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: fleet-manager-secrets
  namespace: fleet
  labels:
    app.kubernetes.io/name: fleet-manager
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # JWT secret for authentication tokens
  # Generate with: openssl rand -base64 32
  jwt-secret: "CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
  
  # Admin password for initial setup
  admin-password: "CHANGE_ME_STRONG_PASSWORD"
  
  # Resend API key from https://resend.com/api-keys
  resend-api-key: "re_CHANGE_ME_YOUR_RESEND_API_KEY"
  
  # Email sender address (must be verified domain in Resend)
  email-from: "Modovolo Fleet <noreply@fleet.modovolo.com>"

---
# PostgreSQL Secrets
apiVersion: v1
kind: Secret
metadata:
  name: postgresql-secret
  namespace: fleet
  labels:
    app.kubernetes.io/name: postgresql
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  POSTGRES_DB: fleet_manager
  POSTGRES_USER: fleet_admin
  # Generate with: openssl rand -base64 24
  POSTGRES_PASSWORD: "CHANGE_ME_POSTGRES_PASSWORD"
  POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=en_US.UTF-8"
