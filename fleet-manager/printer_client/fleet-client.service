[Unit]
Description=Fleet Manager Client
Documentation=https://fleet.modovolo.com
After=network-online.target moonraker.service
Wants=network-online.target
Requires=moonraker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fleet-client
ExecStart=/usr/bin/python3 /opt/fleet-client/fleet_client.py
Restart=always
RestartSec=10
Environment=FLEET_CONFIG_FILE=/etc/fleet-client/config.json
Environment=FLEET_LOG_LEVEL=INFO

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-client

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/fleet-client
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
