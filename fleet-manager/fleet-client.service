[Unit]
Description=Fleet Manager Printer Client
Documentation=https://github.com/jmarji/mainsail
After=network-online.target moonraker.service
Wants=network-online.target
Requires=moonraker.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi

# Main execution
ExecStart=/usr/bin/python3 /home/pi/printer_fleet_client.py

# Restart policy
Restart=always
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# Environment variables
Environment=FLEET_URL=wss://fleet.modovolo.com/ws/printer/
Environment=MOONRAKER_URL=http://127.0.0.1:7125
Environment=PRINTER_ID=
Environment=PYTHONUNBUFFERED=1

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-client

[Install]
WantedBy=multi-user.target
